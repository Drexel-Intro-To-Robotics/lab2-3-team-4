<launch>
    <!-- TurtleBot model -->
    <arg name="model" default="waffle_pi" />

    <!-- Saved map file -->
    <arg name="map_file"
         default="$(find lab2)/maps/maze.yaml" />

    <!-- Saved RViz configuration -->
    <arg name="rviz_config"
         default="$(find lab2)/rviz/astar_visualisation.rviz" />

    <!-- TurtleBot3 model env -->
    <env name="TURTLEBOT3_MODEL" value="$(arg model)" />
    <param name="model" value="$(arg model)" />

    <!-- Robot model for RViz RobotModel -->
    <param name="robot_description"
           command="$(find xacro)/xacro $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro" />

    <node pkg="robot_state_publisher"
          type="robot_state_publisher"
          name="robot_state_publisher"
          output="screen" />

    <!-- Load saved map -->
    <node pkg="map_server"
          type="map_server"
          name="map_server"
          args="$(arg map_file)"
          output="screen" />

    <!-- AMCL localisation: publishes map -> odom and particle cloud -->
    <include file="$(find turtlebot3_navigation)/launch/amcl.launch">
        <arg name="initial_pose_x" value="0.0" />
        <arg name="initial_pose_y" value="0.0" />
        <arg name="initial_pose_a" value="0.0" />
    </include>

      <!-- Optimised A* planner -->
      <node pkg="lab2"
            type="optimised_astar_planner.py"
            name="optimised_astar_planner_node"
            output="screen">

          <param name="use_footprint_cost" value="true" />

          <param name="robot_width_m" value="0.28" />
          <param name="robot_length_m" value="0.30" />
          <param name="safety_margin_m" value="0.02" />

          <param name="hard_clearance_m" value="0.05" />
          <param name="footprint_penalty" value="8.0" />

          <param name="use_soft_buffer" value="false" />

      </node>

    <!-- Path follower -->
    <node pkg="lab2"
          type="path_follower.py"
          name="path_follower_node"
          output="screen">

        <param name="path_topic" value="/astar/waypoints" />
        <param name="max_linear_speed" value="0.035" />
        <param name="max_angular_speed" value="0.35" />
        <param name="distance_tolerance" value="0.12" />
        <param name="angle_tolerance" value="0.06" />
        <param name="linear_gain" value="0.15" />
        <param name="angular_gain" value="1.5" />
        <param name="goal_stop_hold_time" value="1.0" />

    </node>

    <!-- RViz -->
    <node pkg="rviz"
          type="rviz"
          name="rviz_optimised_astar"
          args="-d $(arg rviz_config)"
          output="screen"
          required="false">

        <env name="DISPLAY" value=":0" />
        <env name="QT_X11_NO_MITSHM" value="1" />
        <env name="LIBGL_ALWAYS_SOFTWARE" value="1" />
        <env name="MESA_LOADER_DRIVER_OVERRIDE" value="llvmpipe" />
        <env name="GALLIUM_DRIVER" value="llvmpipe" />

    </node>
</launch>